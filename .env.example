GENSOKYO_MODEL=Qwen3-8B          # Ollama 用 qwen3:8b
GENSOKYO_BASE_URL=http://localhost:8000/v1   # Ollama 是 http://localhost:11434/v1
GENSOKYO_API_KEY=not-needed

# 思考模型（Qwen3 等）会先写几百字推理链才吐出第一个可见字符，
# 实测 qwen3:8b 因此把首字延迟从 2 秒推到 25 秒。设成 none 关掉。
# 留空则完全不发这个参数——严格端点（如 OpenAI 官方）会拒绝未知字段。
GENSOKYO_REASONING=none
